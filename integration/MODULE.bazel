# The integration module builds and tests upspin_drive the way an outside
# module does: as a bazel_dep, with none of the root module's overrides and
# no custom registry. BCR presubmit runs it as the test module; see
# .bcr/presubmit.yml.
module(
    name = "filmil_upspin_drive_integration",
    version = "0.0.0",
)

# repo_name keeps the labels @upspin_drive//..., as a user of the module
# may.
bazel_dep(name = "filmil_upspin_drive", version = "0.0.0", repo_name = "upspin_drive")
local_path_override(
    module_name = "filmil_upspin_drive",
    path = "..",
)

bazel_dep(name = "rules_go", version = "0.61.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "@upspin_drive//:go.mod")

# The test imports upspin.io packages directly, so it names the
# filmil_upspin module that filmil_upspin_drive depends on.
bazel_dep(name = "filmil_upspin", version = "46.0.0", repo_name = "upspin")
