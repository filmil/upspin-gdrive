load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_load", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

# Containers are only compatible with non-Windows platforms.
_NOT_WINDOWS = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Architecture list for multi-arch images.
_ARCH = [
    "amd64",
    "arm64",
]

# Remote tags shared by both :*_push targets, derived from the release tag.
#
#   bazel run //containers:upspinserver_push --embed_label=v42.1.8
#
# publishes exactly one tag, `42.1.8`. The leading `v` of the git tag is
# stripped so the container carries a bare semver, matching the convention used
# for the binaries published alongside each release. No floating `latest` tag is
# published: every image is addressable by an explicit version, so a deployment
# that pins one always names what it actually runs.
#
# Without --embed_label the placeholder `0.0.0` is emitted rather than failing,
# so that `bazel build //...` stays green and this action stays cacheable, as
# recommended in rules_oci's oci_push docs. CI always stamps, and
# .github/workflows/publish-container.yml rejects a non-semver tag before it
# reaches this rule, so `0.0.0` can never reach the registry from a release.
genrule(
    name = "remote_tags",
    outs = ["remote_tags.txt"],
    cmd = """
version=$$(sed -n 's/^BUILD_EMBED_LABEL //p' bazel-out/stable-status.txt)
version=$${version#v}
printf '%s\\n' "$${version:-0.0.0}" > $@
""",
    stamp = 1,
)

# --- upspinserver-drive ---

pkg_tar(
    name = "upspinserver_tar",
    srcs = ["//cmd/upspinserver-drive"],
    package_dir = "/usr/bin",
    target_compatible_with = _NOT_WINDOWS,
)

oci_image(
    name = "upspinserver_image_base",
    base = "@distroless_base",
    entrypoint = ["/usr/bin/upspinserver-drive"],
    target_compatible_with = _NOT_WINDOWS,
    tars = [":upspinserver_tar"],
    visibility = ["//visibility:public"],
)

[
    platform_transition_filegroup(
        name = "upspinserver_image_" + arch,
        srcs = [":upspinserver_image_base"],
        target_platform = "@rules_go//go/toolchain:linux_" + arch,
    )
    for arch in _ARCH
]

oci_image_index(
    name = "upspinserver_image",
    images = [
        ":upspinserver_image_" + arch
        for arch in _ARCH
    ],
    target_compatible_with = _NOT_WINDOWS,
    visibility = ["//visibility:public"],
)

oci_load(
    name = "upspinserver_tarball",
    format = "oci",
    image = ":upspinserver_image",
    repo_tags = ["upspinserver-drive:latest"],
    target_compatible_with = _NOT_WINDOWS,
)

oci_push(
    name = "upspinserver_push",
    image = ":upspinserver_image",
    remote_tags = ":remote_tags",
    repository = "docker.io/filipfilmar/upspinserver-drive",
    target_compatible_with = _NOT_WINDOWS,
)

